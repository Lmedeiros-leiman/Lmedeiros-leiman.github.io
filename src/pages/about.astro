---
import { GITHUB_URL } from '../consts';
import Page from '../layouts/Page.astro';
---

<Page title="About" description="About Leonardo Medeiros Leiman and this site.">
	<h1 class="page-title">About</h1>
	<div class="prose">
		<p>
			I'm Leonardo Medeiros Leiman, a developer. This site is where I write about things I built
			and what I learned along the way.
		</p>
		<p>My code is on <a href={GITHUB_URL}>GitHub</a>.</p>
		<p>
			The site itself is built with <a href="https://astro.build/">Astro</a> and hosted on GitHub
			Pages. New posts show up in the <a href="/rss.xml">RSS feed</a>.
		</p>
	</div>
</Page>
