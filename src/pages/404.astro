---
import Page from '../layouts/Page.astro';
---

<Page title="Page not found" description="There is no page at this address.">
	<h1 class="page-title">Page not found</h1>
	<div class="prose">
		<p>There is no page at this address. It may have moved, or the link may be wrong.</p>
		<p>
			Try the <a href="/">home page</a> or the <a href="/blog/">list of posts</a>.
		</p>
	</div>
</Page>
