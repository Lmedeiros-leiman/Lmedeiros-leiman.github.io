---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, type PostEntry } from '../../utils/posts';

export async function getStaticPaths() {
	const entries = await getPosts();
	return entries.map((entry) => ({
		params: { slug: entry.post.id },
		props: entry,
	}));
}
type Props = PostEntry;

const { post, number, minutes } = Astro.props;
const { Content } = await render(post);
---

<BlogPost post={post} number={number} minutes={minutes}>
	<Content />
</BlogPost>
