---
import PostList from '../components/PostList.astro';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Page from '../layouts/Page.astro';
import { getPosts } from '../utils/posts';

const entries = await getPosts();
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<h1>Hi, I'm Leonardo.</h1>
		<p>
			I'm a developer, and I like fixing the things that slow me down at work instead of living with
			them. So far that has meant a chat app that talks to both of the office messengers we use, a
			SPED file converter that went from using a gigabyte of memory to 80 MB, and this blog, which I
			set up by directing an AI agent.
		</p>
		<p>
			Each post here is the story of one of those: what bugged me, what I tried, and what I learned.
			My code is on <a href={GITHUB_URL}>GitHub</a>.
		</p>
	</section>

	<section class="posts">
		<h2 class="section-title">Posts</h2>
		<PostList entries={entries} />
	</section>
</Page>

<style>
	.intro {
		margin-bottom: 3.5rem;
	}
	.intro h1 {
		margin: 0 0 1rem;
		font-size: clamp(2rem, 1.4rem + 2.6vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.12;
		text-wrap: balance;
	}
	.intro p {
		margin: 0;
		max-width: 34rem;
		font-size: 1.1875rem;
		line-height: 1.55;
	}
	.posts {
		margin-bottom: 2rem;
	}
</style>
