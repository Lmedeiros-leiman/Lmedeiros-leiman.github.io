---
import PostList from '../components/PostList.astro';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Page from '../layouts/Page.astro';
import { getPosts } from '../utils/posts';

const entries = await getPosts();
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<h1>Things I built, written down.</h1>
		<p>
			I'm Leonardo Medeiros Leiman, a developer. Each post here is about something I made and what
			I learned making it. The code is on <a href={GITHUB_URL}>GitHub</a>.
		</p>
	</section>

	<section class="posts">
		<h2 class="section-title">Posts</h2>
		<PostList entries={entries} />
	</section>
</Page>

<style>
	.intro {
		margin-bottom: 3.5rem;
	}
	.intro h1 {
		margin: 0 0 1rem;
		font-size: clamp(2rem, 1.4rem + 2.6vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.12;
		text-wrap: balance;
	}
	.intro p {
		margin: 0;
		max-width: 34rem;
		font-size: 1.1875rem;
		line-height: 1.55;
	}
	.posts {
		margin-bottom: 2rem;
	}
</style>
