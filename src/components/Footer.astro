---
import { GITHUB_URL, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		<p>&copy; {year} {SITE_TITLE}</p>
		<ul>
			<li><a href={GITHUB_URL} rel="me">GitHub</a></li>
			<li><a href="/rss.xml">RSS</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		border-top: 1px solid var(--rule);
		font-family: var(--font-sans);
		font-size: 0.875rem;
		color: var(--muted);
	}
	.wrap {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding-top: 1.5rem;
		padding-bottom: 2.5rem;
	}
	p,
	ul {
		margin: 0;
	}
	ul {
		display: flex;
		gap: 1.5rem;
		padding: 0;
		list-style: none;
	}
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--text);
	}
</style>
