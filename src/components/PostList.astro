---
import type { PostEntry } from '../utils/posts';
import { formatNumber } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	entries: PostEntry[];
	/** Heading level for post titles; use 2 when the list sits directly under the page's h1. */
	headingLevel?: 2 | 3;
}

const { entries, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<ol class="post-list" reversed>
	{
		entries.map(({ post, number, minutes }) => (
			<li>
				<p class="meta">
					<span>{formatNumber(number)}</span>
					<FormattedDate date={post.data.pubDate} />
					<span>{minutes} min read</span>
				</p>
				<Heading class="post-title">
					<a href={`/blog/${post.id}/`}>{post.data.title}</a>
				</Heading>
				<p class="description">{post.data.description}</p>
			</li>
		))
	}
</ol>

<style>
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		padding: 1.5rem 0;
		border-top: 1px solid var(--rule);
	}
	li:last-child {
		border-bottom: 1px solid var(--rule);
	}
	.post-title {
		margin: 0.375rem 0 0.5rem;
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.25;
	}
	.post-title a {
		color: var(--text);
		text-decoration: none;
	}
	.post-title a:hover {
		color: var(--accent);
	}
	.description {
		margin: 0;
		color: var(--muted);
		font-size: 1.0625rem;
	}
</style>
