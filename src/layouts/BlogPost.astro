---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { formatNumber } from '../utils/posts';
import Page from './Page.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	number: number;
	minutes: number;
}

const { post, number, minutes } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Page title={title} description={description} image={heroImage} type="article">
	<article class="post">
		<header class="post-header">
			<p class="meta">
				<span>{formatNumber(number)}</span>
				<FormattedDate date={pubDate} />
				<span>{minutes} min read</span>
				{
					updatedDate && (
						<span>
							Updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
			<h1>{title}</h1>
			<p class="lede">{description}</p>
			{
				heroImage && (
					<Image
						class="hero"
						width={1200}
						src={heroImage}
						alt=""
						loading="eager"
						fetchpriority="high"
					/>
				)
			}
		</header>
		<div class="prose">
			<slot />
		</div>
		<footer class="post-footer">
			<a href="/blog/">All posts</a>
		</footer>
	</article>
</Page>

<style>
	.post-header {
		margin-bottom: 2.5rem;
	}
	.post-header h1 {
		margin: 0.5rem 0 0.75rem;
		font-size: clamp(2rem, 1.4rem + 2.6vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.12;
		text-wrap: balance;
	}
	.lede {
		margin: 0;
		font-size: 1.1875rem;
		line-height: 1.5;
		color: var(--muted);
	}
	.hero {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 2rem;
		border-radius: 6px;
	}
	.post-footer {
		margin-top: 3.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		font-family: var(--font-sans);
		font-size: 0.9375rem;
	}
	.post-footer a {
		color: var(--muted);
		text-decoration: none;
	}
	.post-footer a::before {
		content: '\2190\00a0';
	}
	.post-footer a:hover {
		color: var(--accent);
	}
</style>
